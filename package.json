{
    "name": "itera",
    "version": "0.2.3",
    "description": "Edit-in-place résumé editor: your résumé is one HTML file. Flowing columns, fit-to-one-page, PDF/DOCX/PNG export. One prebuilt folder, no build.",
    "author": "Q Manning (https://qmanning.com)",
    "homepage": "https://qmanning.com/labs/itera",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/qmanning/itera.git"
    },
    "bugs": {
        "url": "https://github.com/qmanning/itera/issues"
    },
    "keywords": [
        "resume",
        "cv",
        "editor",
        "wysiwyg",
        "tiptap",
        "pdf",
        "docx",
        "ats",
        "static",
        "no-build"
    ],
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "node build.mjs",
        "test": "node --test test/unit/*.test.mjs",
        "serve": "node test/serve.mjs 7333"
    },
    "devDependencies": {
        "@tiptap/core": "^3.0.1",
        "@tiptap/extension-color": "^3.0.1",
        "@tiptap/extension-text-align": "^3.0.1",
        "@tiptap/extension-text-style": "^3.0.1",
        "@tiptap/pm": "^3.0.1",
        "@tiptap/starter-kit": "^3.0.1",
        "docx": "9.5.1",
        "esbuild": "^0.25.9",
        "jsdom": "^26.1.0",
        "lucide-react": "^0.523.0",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "typescript": "^5.9.2"
    }
}
